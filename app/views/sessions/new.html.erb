<h1>ログイン</h1>

<section data-controller="passkey-authentication">
  <h2>パスキーでログイン</h2>
  <button type="button" data-action="passkey-authentication#authenticateWithButton">パスキーでログイン</button>
  <p data-passkey-authentication-target="status"></p>
</section>

<section>
  <h2>パスワードでログイン</h2>

  <% if flash[:alert] %>
    <p><%= flash[:alert] %></p>
  <% end %>

  <%= form_with url: login_path do |form| %>
    <div>
      <%= form.label :username, "ユーザー名" %>
      <%= form.text_field :username, autocomplete: "username webauthn" %>
    </div>

    <div>
      <%= form.label :password, "パスワード" %>
      <%= form.password_field :password %>
    </div>

    <%= form.submit "ログイン" %>
  <% end %>
</section>

<p><%= link_to "新規登録はこちら", signup_path %></p>
